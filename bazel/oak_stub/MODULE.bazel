# Empty stand-in for the oak module, used only when MBS is built standalone.
#
# pcit_api depends on oak for the TCA policy protos and resolves it with an
# archive_override, which Bazel only honours in the root module. MBS consumes
# just google/mbs/v1/certificates_config.proto from pcit_api and never builds
# an oak target, while the real oak module would pull its C++/Rust toolchains,
# gRPC and Maven artifacts into the MBS dependency graph. TCA, PES and TLedger
# override oak with the real archive, so this stub is never used by them.
module(
    name = "oak",
    version = "0.0.0",
)
